{
  "title": "Workloads",
  "uid": "workloads",
  "tags": [
    "platform",
    "pods"
  ],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Top pods \u2014 CPU (cores)",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(12, sum by (namespace, pod) (k8s_pod_cpu_usage{node=~\"$node\"}))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Top pods \u2014 memory (working set)",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(12, sum by (namespace, pod) (k8s_pod_memory_working_set{node=~\"$node\"}))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Top pods \u2014 network I/O",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (pod) (rate(k8s_pod_network_io{node=~\"$node\"}[2m])))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Container restarts (cumulative)",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (namespace, pod) (k8s_container_restarts{node=~\"$node\"}) != 0)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Running pods per node",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (node) (k8s_pod_phase{node=~\"$node\"} == 2)",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "stat",
      "title": "Containers not ready",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(k8s_container_ready{node=~\"$node\"} == 0) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Top pods \u2014 filesystem usage",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (namespace, pod) (k8s_pod_filesystem_usage{node=~\"$node\"}))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "table",
      "title": "Resources — requests / limits / usage (per container)",
      "description": "Per-container CPU (cores) and memory (working set) usage alongside its configured requests and limits.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod, container) (container_cpu_usage{node=~\"$node\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum by (namespace, pod, container) (k8s_container_cpu_request{node=~\"$node\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "sum by (namespace, pod, container) (k8s_container_cpu_limit{node=~\"$node\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "sum by (namespace, pod, container) (container_memory_working_set{node=~\"$node\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "sum by (namespace, pod, container) (k8s_container_memory_request{node=~\"$node\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "sum by (namespace, pod, container) (k8s_container_memory_limit{node=~\"$node\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "CPU usage",
              "Value #B": "CPU req",
              "Value #C": "CPU limit",
              "Value #D": "Mem usage",
              "Value #E": "Mem req",
              "Value #F": "Mem limit"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "CPU.*" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 3 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "Mem.*" },
            "properties": [
              { "id": "unit", "value": "bytes" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Mem usage",
            "desc": true
          }
        ]
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "metrics"
        },
        "query": "label_values(k8s_node_condition_ready, node)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}