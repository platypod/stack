{{- /*
  Shared default values loaded for every environment, in dependency order:
    1. Foundational — no cross-refs or self-refs only
    2. Services     — reference foundational values
    3. Aggregators  — reference all service hosts (authelia); must come last
  Each environment appends its own override file at the end.
*/ -}}
{{- $defaultValues := list
  "values/default/core/project.yaml"
  "values/default/core/k8s.yaml"
  "values/default/core/priority.yaml"
  "values/default/core/traefik.yaml"
  "values/default/core/acme.yaml"
  "values/default/persistence/storage.yaml"
  "values/default/observability/common.yaml"
  "values/default/media/media.yaml"
  "values/default/core/homepage.yaml"
  "values/default/security/adguard.yaml"
  "values/default/security/lldap.yaml"
  "values/default/security/access-groups.yaml"
  "values/default/security/vaultwarden.yaml"
  "values/default/dev-tools/cyber-chef.yaml"
  "values/default/observability/dashboards.yaml"
  "values/default/observability/logs.yaml"
  "values/default/observability/metrics.yaml"
  "values/default/observability/scope-shim.yaml"
  "values/default/observability/otel-collectors.yaml"
  "values/default/observability/prometheus-json-exporter.yaml"
  "values/default/observability/prometheus-snmp-exporter.yaml"
  "values/default/observability/uptime-kuma.yaml"
  "values/default/observability/traces.yaml"
  "values/default/observability/pyroscope.yaml"
  "values/default/media/database.yaml"
  "values/default/dev-tools/bookstack.yaml"
  "values/default/dev-tools/wikijs.yaml"
  "values/default/dev-tools/outline.yaml"
  "values/default/dev-tools/dbeaver.yaml"
  "values/default/dev-tools/it-tools.yaml"
  "values/default/dev-tools/whoami.yaml"
  "values/default/dev-tools/headroom.yaml"
  "values/default/files/deluge.yaml"
  "values/default/files/qbittorrent.yaml"
  "values/default/files/sabnzbd.yaml"
  "values/default/files/transmission.yaml"
  "values/default/media/bazarr.yaml"
  "values/default/media/flaresolverr.yaml"
  "values/default/media/jellyfin.yaml"
  "values/default/media/jellyfin-k8s.yaml"
  "values/default/media/jellyswarrm.yaml"
  "values/default/media/jellyseerr.yaml"
  "values/default/media/prowlarr.yaml"
  "values/default/media/radarr.yaml"
  "values/default/media/readarr.yaml"
  "values/default/media/sonarr.yaml"
  "values/default/media/komga.yaml"
  "values/default/media/kavita.yaml"
  "values/default/media/audiobookshelf.yaml"
  "values/default/media/suwayomi.yaml"
  "values/default/media/mediarvester.yaml"
  "values/default/media/gpu-device-plugin.yaml"
  "values/default/media/tdarr.yaml"
  "values/default/media/reclaimerr.yaml"
  "values/default/games/pokeclicker.yaml"
  "values/default/games/rommapp.yaml"
  "values/default/games/unbegotten.yaml"
  "values/default/games/palworld.yaml"
  "values/default/games/minecraft.yaml"
  "values/default/games/valheim.yaml"
  "values/default/games/terraria.yaml"
  "values/default/games/satisfactory.yaml"
  "values/default/games/backups.yaml"
  "values/default/security/authelia.yaml"
-}}
{{- $releaseValues := append $defaultValues (printf "values/%s/values.yaml" .Environment.Name) -}}

environments:
  # dev: migrated to platypod-sops (Phase 1, dev-only for now — see
  # stack/docs/flux-migration.md). `make decrypt-secrets` (a prerequisite of
  # diff/deploy) decrypts the SOPS file to tmp/secrets/dev.yaml via the sops
  # binary directly — NOT helmfile's native `secrets:` stanza, which shells
  # out to the helm-secrets plugin; that plugin is currently broken on Helm
  # v4 (drops its `helm secrets` CLI subcommand for legacy plugins that also
  # declare `downloaders:`). prd stays on the NFS-linked values.yaml until
  # its own migration; this dev/prd split is temporary scaffolding, collapsed
  # back to one code path once prd migrates too.
  dev:
    values:
{{ append $defaultValues "tmp/secrets/dev.yaml" | toYaml | indent 6 }}
  prd:
    values:
{{ append $defaultValues "values/prd/values.yaml" | toYaml | indent 6 }}

---

{{- /*
  $defaultValues is redefined here (Go template variables don't cross --- boundaries).
  Keep this list in sync with the one above in the environments section.
*/ -}}
{{- $defaultValues := list
  "values/default/core/project.yaml"
  "values/default/core/k8s.yaml"
  "values/default/core/priority.yaml"
  "values/default/core/traefik.yaml"
  "values/default/core/acme.yaml"
  "values/default/persistence/storage.yaml"
  "values/default/observability/common.yaml"
  "values/default/media/media.yaml"
  "values/default/core/homepage.yaml"
  "values/default/security/adguard.yaml"
  "values/default/security/lldap.yaml"
  "values/default/security/access-groups.yaml"
  "values/default/security/vaultwarden.yaml"
  "values/default/dev-tools/cyber-chef.yaml"
  "values/default/observability/dashboards.yaml"
  "values/default/observability/logs.yaml"
  "values/default/observability/metrics.yaml"
  "values/default/observability/scope-shim.yaml"
  "values/default/observability/otel-collectors.yaml"
  "values/default/observability/prometheus-json-exporter.yaml"
  "values/default/observability/prometheus-snmp-exporter.yaml"
  "values/default/observability/uptime-kuma.yaml"
  "values/default/observability/traces.yaml"
  "values/default/observability/pyroscope.yaml"
  "values/default/media/database.yaml"
  "values/default/dev-tools/bookstack.yaml"
  "values/default/dev-tools/wikijs.yaml"
  "values/default/dev-tools/outline.yaml"
  "values/default/dev-tools/dbeaver.yaml"
  "values/default/dev-tools/it-tools.yaml"
  "values/default/dev-tools/whoami.yaml"
  "values/default/dev-tools/headroom.yaml"
  "values/default/files/deluge.yaml"
  "values/default/files/qbittorrent.yaml"
  "values/default/files/sabnzbd.yaml"
  "values/default/files/transmission.yaml"
  "values/default/media/bazarr.yaml"
  "values/default/media/flaresolverr.yaml"
  "values/default/media/jellyfin.yaml"
  "values/default/media/jellyfin-k8s.yaml"
  "values/default/media/jellyswarrm.yaml"
  "values/default/media/jellyseerr.yaml"
  "values/default/media/prowlarr.yaml"
  "values/default/media/radarr.yaml"
  "values/default/media/readarr.yaml"
  "values/default/media/sonarr.yaml"
  "values/default/media/komga.yaml"
  "values/default/media/kavita.yaml"
  "values/default/media/audiobookshelf.yaml"
  "values/default/media/suwayomi.yaml"
  "values/default/media/mediarvester.yaml"
  "values/default/media/gpu-device-plugin.yaml"
  "values/default/media/tdarr.yaml"
  "values/default/media/reclaimerr.yaml"
  "values/default/games/pokeclicker.yaml"
  "values/default/games/rommapp.yaml"
  "values/default/games/unbegotten.yaml"
  "values/default/games/palworld.yaml"
  "values/default/games/minecraft.yaml"
  "values/default/games/valheim.yaml"
  "values/default/games/terraria.yaml"
  "values/default/games/satisfactory.yaml"
  "values/default/games/backups.yaml"
  "values/default/security/authelia.yaml"
-}}
{{- /*
  dev: migrated to platypod-sops (Phase 1, dev-only — see
  stack/docs/flux-migration.md). `make decrypt-secrets` decrypts the SOPS
  file to tmp/secrets/dev.yaml before helmfile runs (not helmfile's native
  `secrets:` stanza — see the comment on the environments block above for
  why). prd: unchanged, still the NFS-linked values.yaml. Temporary
  scaffolding until prd migrates too.
*/ -}}
{{- $releaseValues := $defaultValues -}}
{{- if eq .Environment.Name "dev" }}
{{- $releaseValues = append $defaultValues "tmp/secrets/dev.yaml" }}
{{- else }}
{{- $releaseValues = append $defaultValues (printf "values/%s/values.yaml" .Environment.Name) }}
{{- end }}

releases:
  - name: "{{ .Environment.Name }}--platypod--persistence"
    chart: ./src/persistence
    namespace: "{{ .Values.k8s.namespace }}"
    values:
{{ $releaseValues | toYaml | indent 6 }}

  - name: "{{ .Environment.Name }}--platypod--core"
    chart: ./src/core
    namespace: "{{ .Values.k8s.namespace }}"
    needs:
      - "{{ .Environment.Name }}--platypod--persistence"
    values:
{{ $releaseValues | toYaml | indent 6 }}

  - name: "{{ .Environment.Name }}--platypod--security"
    chart: ./src/security
    namespace: "{{ .Values.k8s.namespace }}"
    needs:
      - "{{ .Environment.Name }}--platypod--core"
    values:
{{ $releaseValues | toYaml | indent 6 }}

  - name: "{{ .Environment.Name }}--platypod--observability"
    chart: ./src/observability
    namespace: "{{ .Values.k8s.namespace }}"
    needs:
      - "{{ .Environment.Name }}--platypod--core"
      - "{{ .Environment.Name }}--platypod--security"
    values:
{{ $releaseValues | toYaml | indent 6 }}

  - name: "{{ .Environment.Name }}--platypod--dev-tools"
    chart: ./src/dev-tools
    namespace: "{{ .Values.k8s.namespace }}"
    needs:
      - "{{ .Environment.Name }}--platypod--core"
      - "{{ .Environment.Name }}--platypod--security"
    values:
{{ $releaseValues | toYaml | indent 6 }}

  - name: "{{ .Environment.Name }}--platypod--files"
    chart: ./src/files
    namespace: "{{ .Values.k8s.namespace }}"
    needs:
      - "{{ .Environment.Name }}--platypod--core"
      - "{{ .Environment.Name }}--platypod--security"
      - "{{ .Environment.Name }}--platypod--persistence"
      # sabnzbd-setup wires itself into Sonarr/Radarr/Readarr/Prowlarr via their
      # APIs — needs their Services (and thus DNS) to exist first.
      - "{{ .Environment.Name }}--platypod--media"
    values:
{{ $releaseValues | toYaml | indent 6 }}

  - name: "{{ .Environment.Name }}--platypod--media"
    chart: ./src/media
    namespace: "{{ .Values.k8s.namespace }}"
    needs:
      - "{{ .Environment.Name }}--platypod--core"
      - "{{ .Environment.Name }}--platypod--security"
      - "{{ .Environment.Name }}--platypod--persistence"
    values:
{{ $releaseValues | toYaml | indent 6 }}

  - name: "{{ .Environment.Name }}--platypod--games"
    chart: ./src/games
    namespace: "{{ .Values.k8s.namespace }}"
    needs:
      - "{{ .Environment.Name }}--platypod--core"
      - "{{ .Environment.Name }}--platypod--security"
      - "{{ .Environment.Name }}--platypod--persistence"
    values:
{{ $releaseValues | toYaml | indent 6 }}
