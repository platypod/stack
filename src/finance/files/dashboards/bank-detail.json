    {
      "id": 8,
      "type": "table",
      "title": "Transactions",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finance"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finance"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT spend_date AS date, account, person, amount, label, category, subcategory, necessity, source, rule_id, txn_id FROM gold.bank_transaction_detail WHERE person in ($person) AND account in ($account) AND category in ($category) AND label ILIKE '%${search}%' AND $__timeFilter(spend_date) ORDER BY spend_date DESC, abs(amount) DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {},
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "amount"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "description": "Filter with the variables above (person, account, category, label search) and the time range (on the reporting date)."
