{
  "uid": "claude-custom-indicators",
  "title": "Claude - Custom indicators",
  "tags": [
    "platypod",
    "claude-code",
    "transcripts"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "timezone": "",
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "currency",
        "type": "custom",
        "label": "Currency",
        "query": "\u20ac : EUR,$ : USD,\u00a5 : JPY,\u00a3 : GBP,CHF : CHF,C$ : CAD,A$ : AUD",
        "current": {
          "text": "\u20ac",
          "value": "EUR"
        },
        "options": []
      },
      {
        "name": "project",
        "type": "query",
        "label": "Project",
        "datasource": {
          "type": "prometheus",
          "uid": "metrics"
        },
        "query": {
          "query": "label_values(claude_tx_event_epoch_seconds, project)",
          "refId": "A"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "session",
        "type": "query",
        "label": "Session",
        "datasource": {
          "type": "prometheus",
          "uid": "metrics"
        },
        "query": {
          "query": "label_values(claude_tx_event_epoch_seconds{project=~\"$project\"}, session_title)",
          "refId": "A"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "tool",
        "type": "query",
        "label": "Tool",
        "datasource": {
          "type": "prometheus",
          "uid": "metrics"
        },
        "query": {
          "query": "label_values(claude_tx_tool_calls, tool_name)",
          "refId": "A"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cost (${currency:text})",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "expr": "sum(sum_over_time(claude_tx_cost_usd{project=~\"$project\", session_title=~\"${session:regex}\"}[$__range])) * on() group_left() (sum(usd_fx_rate{currency=\"$currency\"}) or vector(1))",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg cost / session (${currency:text})",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 3,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "expr": "(sum(sum_over_time(claude_tx_cost_usd{project=~\"$project\", session_title=~\"${session:regex}\"}[$__range])) * on() group_left() (sum(usd_fx_rate{currency=\"$currency\"}) or vector(1))) / clamp_min(count(count by (session_id)(sum_over_time(claude_tx_event_epoch_seconds{project=~\"$project\", session_title=~\"${session:regex}\"}[$__range]))),1)",
          "instant": true
        }
      ]
    },
