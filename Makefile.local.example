# stack/Makefile.local — per-machine overrides (COPY to Makefile.local; gitignored)
# -----------------------------------------------------------------------------
# Optional. STATE_MOUNT points at the NFS share used to back up the SOPS age
# private key (see `make setup-age-key` in Makefile) — a rebuilt or new
# machine restores it from there instead of generating a fresh one (which
# couldn't decrypt anything already in platypod-sops). Mirrors
# infra/Makefile.local's STATE_MOUNT.
# -----------------------------------------------------------------------------

STATE_MOUNT := $(HOME)/nfs/platypod
