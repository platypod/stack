{
  "title": "mediarvester",
  "uid": "mediarvester",
  "tags": ["mediarvester", "media"],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Active downloads",
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "mediarvester_download_active" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Queue depth",
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "refId": "A", "expr": "mediarvester_download_queue_depth" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 3, "color": "yellow" },
              { "value": 8, "color": "red" }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Downloads degraded?",
      "description": "1 if recent failures look site-wide (see mediarvester's service_status.py heuristic), else 0.",
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "refId": "A", "expr": "mediarvester_service_degraded" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OK" }, "1": { "text": "DEGRADED" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "value": null, "color": "green" }, { "value": 1, "color": "red" }]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Library size",
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "refId": "A", "expr": "mediarvester_media_items_total" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Download success rate",
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mediarvester_download_completed_total{status=\"done\"}[15m])) / sum(rate(mediarvester_download_completed_total[15m])) * 100",
          "legendFormat": "success rate"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Downloads started, by collection vs single video",
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (is_collection) (rate(mediarvester_download_started_total[15m]))",
          "legendFormat": "collection={{is_collection}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Download duration (p50 / p95) by outcome",
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, status) (rate(mediarvester_download_duration_bucket[15m])))",
          "legendFormat": "p50 {{status}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, status) (rate(mediarvester_download_duration_bucket[15m])))",
          "legendFormat": "p95 {{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Auto-retries scheduled, by attempt",
      "description": "Attempt 1/2/3 -- see downloader.py's _MAX_AUTO_RETRIES / _RETRY_DELAYS_SECONDS. A rising attempt-3 count means items are exhausting all retries and staying failed.",
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (attempt) (rate(mediarvester_download_retry_total[15m]))",
          "legendFormat": "attempt {{attempt}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Source polls, by outcome",
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(mediarvester_poller_poll_total[15m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "New entries discovered by followed sources",
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mediarvester_poller_new_entries_total[1h]))",
          "legendFormat": "new entries/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Playlist-folder placement lookups, hit rate",
      "description": "How often a followed creator's new video matched an already-downloaded playlist (see poller.py's _matching_known_playlist / folder_hint).",
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (matched) (rate(mediarvester_poller_playlist_match_total[1h]))",
          "legendFormat": "matched={{matched}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
