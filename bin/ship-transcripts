#!/usr/bin/env python3
"""Ship Claude Code session transcripts to Loki via the existing OTLP gateway.

Reads the per-project JSONL transcripts under ~/.claude/projects/, redacts the
literal secret values harvested from stack/values/**/*.yaml, and emits one OTLP
log record per content-bearing line to the cluster's OTLP/gRPC gateway — reusing
the endpoint + Basic-auth header already configured in ~/.claude/settings.json
(the same path Claude Code's own telemetry uses). No daemon: run it on demand
(see `make ship-transcripts`). Byte offsets are tracked per file so re-runs only
ship new lines; the first run backfills everything.

Logs land in Loki as {service_name="claude-code-transcripts"}. The full (redacted)
JSONL line is the log body; session_id / session_title / type / uuid / parent_uuid
/ tool_name / tool_use_id / project / git_branch ride along as attributes.

It also derives numeric metrics from the structured fields (tokens, cost, tool
calls/latency/errors, turns, stop reasons, per-message event epoch) and pushes
them to Mimir over the same OTLP gateway as gauges stamped at each message's
event time — see the metrics block below for the gauge-vs-counter rationale.
"""
from __future__ import annotations
import argparse, glob, json, os, re, socket, sys, time
from datetime import datetime
from pathlib import Path

HOME = Path.home()
PROJECTS_DIR = HOME / ".claude" / "projects"
SETTINGS = HOME / ".claude" / "settings.json"
# Per-file byte offsets. Overridable so a one-off backfill to a *different*
# gateway (e.g. dev via a port-forward) tracks its own offsets instead of
# clobbering the shared/prod state. Defaults to the prod state path.
STATE = Path(os.environ.get("PLATYPOD_TRANSCRIPT_STATE",
                            HOME / ".claude" / ".platypod-transcript-shipper.json"))
REPO_VALUES = Path(__file__).resolve().parent.parent / "values"

# Line types worth shipping (these carry message content). Others (queue-operation,
# mode, last-prompt, ai-title) are skipped — ai-title is consumed for naming only.
CONTENT_TYPES = {"user", "assistant", "system"}

# Keys whose values are secrets to redact (matched case-insensitively as a substring
# of the YAML key). Harvested literally from stack/values so we redact exact strings.
SECRET_KEY_RE = re.compile(
    r"(?i)(password|passwd|secret|token|apikey|api_key|jwt|hmac|"
    r"encryptionkey|client_secret|clientsecret|accesskey|privatekey)"
)
# Generic shapes harvesting can't cover (pasted creds, key blocks).
GENERIC_REDACTIONS = [
    re.compile(r"(?i)(authorization\s*[:=]\s*(?:basic|bearer)\s+)[A-Za-z0-9._\-+/=]+"),
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]+?-----END [A-Z ]*PRIVATE KEY-----"),
]
REDACTED = "«redacted»"

# ---------------------------------------------------------------------------
# Derived metrics (Layer A — "Claude supervision" insights).
#
# Alongside the content logs, we derive numeric metrics from the structured
# transcript fields and push them to Mimir as OTLP **gauges stamped at each
# message's own event time** (not process-clock counters). Why gauges:
#   * Mimir's OTLP ingestion requires CUMULATIVE temporality and rejects deltas;
#     gauges sidestep temporality entirely.
#   * The shipper backfills history and re-ships incrementally (offset state), so
#     a process-uptime counter can't be reconstructed correctly across runs. A
#     gauge carrying the per-message value at the message's timestamp is
#     idempotent (re-ship → same value at same ts) and backfill-safe.
# Dashboards aggregate with PromQL `sum_over_time` / `quantile_over_time` /
# max-min over the chosen range. The standard OTel metrics SDK won't backdate
# datapoints, so we build OTLP datapoints directly (see emit_metrics).
# ---------------------------------------------------------------------------

# Per-model base rates, USD per million tokens: (input, output). From the
# claude-api model reference. Matched by str.startswith so dated/suffixed model
# ids resolve. Cache rates derive from Anthropic's standard multipliers below.
MODEL_RATES = {
    "claude-fable-5":    (10.0, 50.0),
    "claude-mythos-5":   (10.0, 50.0),
    "claude-opus-4-8":   (5.0, 25.0),
    "claude-opus-4-7":   (5.0, 25.0),
    "claude-opus-4-6":   (5.0, 25.0),
    "claude-opus-4-5":   (5.0, 25.0),
    "claude-opus-4-1":   (15.0, 75.0),
    "claude-opus-4-0":   (15.0, 75.0),
    "claude-sonnet-4-6": (3.0, 15.0),
    "claude-sonnet-4-5": (3.0, 15.0),
    "claude-haiku-4-5":  (1.0, 5.0),
}
DEFAULT_RATE = (5.0, 25.0)  # unknown model → assume Opus-tier
CACHE_READ_MULT = 0.10      # cache read  = 0.1x  input rate
CACHE_WRITE_5M_MULT = 1.25  # 5m cache write = 1.25x input rate
CACHE_WRITE_1H_MULT = 2.00  # 1h cache write = 2x   input rate


def model_rates(model: str) -> tuple[float, float]:
    for key, rate in MODEL_RATES.items():
        if model.startswith(key):
            return rate
    return DEFAULT_RATE


def message_cost_usd(usage: dict, model: str) -> float:
    """USD cost of one assistant message from its `usage` block + model rates."""
    in_rate, out_rate = model_rates(model)
    cc = usage.get("cache_creation") or {}
    w5 = cc.get("ephemeral_5m_input_tokens", 0) or 0
    w1h = cc.get("ephemeral_1h_input_tokens", 0) or 0
    if not cc:  # older shape: only a flat cache_creation_input_tokens → treat as 5m
        w5 = usage.get("cache_creation_input_tokens", 0) or 0
    return (
        (usage.get("input_tokens", 0) or 0) * in_rate
        + (usage.get("output_tokens", 0) or 0) * out_rate
        + (usage.get("cache_read_input_tokens", 0) or 0) * in_rate * CACHE_READ_MULT
        + w5 * in_rate * CACHE_WRITE_5M_MULT
        + w1h * in_rate * CACHE_WRITE_1H_MULT
    ) / 1_000_000


def to_epoch_ns(ts: str) -> int | None:
    """ISO-8601 transcript timestamp → epoch nanoseconds (None if unparseable)."""
    if not ts:
        return None
    try:
        return int(datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp() * 1e9)
    except ValueError:
        return None


def harvest_secrets(values_dir: Path) -> list[str]:
    """Collect literal secret values from stack/values/**/*.yaml."""
    secrets: set[str] = set()
    kv = re.compile(r"^\s*([\w.\-]+)\s*:\s*(.+?)\s*(?:#.*)?$")
    for path in values_dir.rglob("*.yaml"):
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for line in text.splitlines():
            m = kv.match(line)
            if not m:
                continue
            key, val = m.group(1), m.group(2).strip().strip('"').strip("'")
            if not SECRET_KEY_RE.search(key):
                continue
            # skip templated refs, placeholders, empties, booleans, too-short
            if (not val or len(val) < 6 or val.startswith("{{") or
                    val.startswith("<") or val.lower() in ("true", "false", "null")):
                continue
            secrets.add(val)
    # longest first so substrings don't leave fragments behind
    return sorted(secrets, key=len, reverse=True)


def redact(text: str, secrets: list[str]) -> str:
    for s in secrets:
        if s in text:
            text = text.replace(s, REDACTED)
    for rx in GENERIC_REDACTIONS:
        text = rx.sub(lambda m: (m.group(1) if m.lastindex else "") + REDACTED, text)
    return text


def load_settings() -> tuple[str, dict]:
    """Return (grpc_endpoint, headers) for the OTLP gateway.

    Process env (OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_EXPORTER_OTLP_HEADERS) wins
    over ~/.claude/settings.json — lets you temporarily target a different
    gateway (e.g. a local port-forward to the dev cluster) without editing the
    live Claude Code settings."""
    env = json.loads(SETTINGS.read_text()).get("env", {})
    ep = (os.environ.get("OTEL_EXPORTER_OTLP_ENDPOINT")
          or env.get("OTEL_EXPORTER_OTLP_ENDPOINT", "")).strip()
    if not ep:
        sys.exit("No OTEL_EXPORTER_OTLP_ENDPOINT in env or ~/.claude/settings.json")
    headers = {}
    raw = os.environ.get("OTEL_EXPORTER_OTLP_HEADERS") or env.get("OTEL_EXPORTER_OTLP_HEADERS", "")
    for part in raw.split(","):
        if "=" in part:
            k, v = part.split("=", 1)
            headers[k.strip().lower()] = v.strip()  # gRPC metadata keys must be lowercase
    return ep, headers


def load_state() -> dict:
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(state: dict) -> None:
    STATE.write_text(json.dumps(state, indent=0))


def session_titles(path: Path) -> dict[str, str]:
    """Latest ai-title per sessionId in a file → the session's display name."""
    titles: dict[str, str] = {}
    try:
        for line in path.open(encoding="utf-8", errors="replace"):
            if '"ai-title"' not in line:
                continue
            try:
                o = json.loads(line)
            except ValueError:
                continue
            if o.get("type") == "ai-title" and o.get("aiTitle"):
                titles[o.get("sessionId", "")] = o["aiTitle"]
    except OSError:
        pass
    return titles


def tool_fields(msg: dict) -> dict:
    """Pull tool_name / tool_use_id from the first tool block, for linking."""
    out = {}
    content = msg.get("content")
    if isinstance(content, list):
        for blk in content:
            if not isinstance(blk, dict):
                continue
            if blk.get("type") == "tool_use":
                out["tool_name"] = str(blk.get("name", ""))
                out["tool_use_id"] = str(blk.get("id", ""))
                break
            if blk.get("type") == "tool_result":
                out["tool_use_id"] = str(blk.get("tool_use_id", ""))
                break
    return out


def render_body(o: dict) -> str:
    """Render a transcript line into readable text (instead of a raw JSON blob),
    so the Grafana logs panel is legible. Full content is preserved — text, tool
    inputs and tool results — just unwrapped from the JSON envelope (whose ids/
    metadata already travel as structured metadata)."""
    msg = o.get("message") if isinstance(o.get("message"), dict) else {}
    content = msg.get("content")
    if isinstance(content, str):
        return content
    parts = []
    if isinstance(content, list):
        for b in content:
            if not isinstance(b, dict):
                continue
            t = b.get("type")
            if t == "text":
                parts.append(b.get("text", ""))
            elif t == "thinking":
                parts.append("💭 " + (b.get("thinking", "") or ""))
            elif t == "tool_use":
                inp = json.dumps(b.get("input", {}), ensure_ascii=False)
                parts.append(f"🔧 {b.get('name', 'tool')}({inp})")
            elif t == "tool_result":
                c = b.get("content")
                if isinstance(c, list):
                    c = "\n".join(x.get("text", "") if isinstance(x, dict) else str(x)
                                  for x in c)
                err = " [error]" if b.get("is_error") else ""
                parts.append(f"↳{err} {c}")
    body = "\n".join(p for p in parts if p).strip()
    return body or f"({o.get('type', 'message')})"


def emit_metrics(o: dict, msg: dict, sid: str, project: str, title: str,
                 tool_use_map: dict, add) -> None:
    """Derive gauge datapoints from one transcript line and hand them to `add`.

    All datapoints are stamped at the message's own event time so PromQL can
    aggregate them (sum_over_time for counts/tokens/cost, quantile_over_time for
    latency, max-min of the epoch gauge for session duration)."""
    ts = to_epoch_ns(o.get("timestamp"))
    if ts is None:
        return
    typ = o.get("type")
    base = {"project": project, "session_id": sid, "session_title": title}
    # Per-session min/max → session duration & time-of-day, for every content line.
    add("claude_tx_event_epoch_seconds", ts / 1e9, ts, **base)

    if typ == "assistant":
        usage = msg.get("usage") or {}
        model = str(msg.get("model", "") or "")
        mbase = dict(base, model=model)
        cc = usage.get("cache_creation") or {}
        cache_write = ((cc.get("ephemeral_5m_input_tokens", 0) or 0)
                       + (cc.get("ephemeral_1h_input_tokens", 0) or 0))
        if not cc:
            cache_write = usage.get("cache_creation_input_tokens", 0) or 0
        for kind, val in (
            ("input", usage.get("input_tokens", 0) or 0),
            ("output", usage.get("output_tokens", 0) or 0),
            ("cache_read", usage.get("cache_read_input_tokens", 0) or 0),
            ("cache_write", cache_write),
        ):
            if val:
                add("claude_tx_tokens", val, ts, kind=kind, **mbase)
        if usage:
            add("claude_tx_cost_usd", message_cost_usd(usage, model), ts, **mbase)
        sr = msg.get("stop_reason")
        if sr:
            add("claude_tx_stop_reason", 1, ts, stop_reason=str(sr), **base)
        content = msg.get("content")
        if isinstance(content, list):
            counts: dict[str, int] = {}
            for blk in content:
                if isinstance(blk, dict) and blk.get("type") == "tool_use":
                    name = str(blk.get("name", ""))
                    counts[name] = counts.get(name, 0) + 1
                    tid = str(blk.get("id", ""))
                    if tid:
                        tool_use_map[tid] = (name, ts)
            for name, n in counts.items():
                add("claude_tx_tool_calls", n, ts, tool_name=name, **base)

    elif typ == "user":
        content = msg.get("content")
        results = ([b for b in content if isinstance(b, dict)
                    and b.get("type") == "tool_result"]
                   if isinstance(content, list) else [])
        for b in results:
            name, use_ts = tool_use_map.get(str(b.get("tool_use_id", "")), ("", None))
            tn = {"tool_name": name} if name else {}
            if b.get("is_error"):
                add("claude_tx_tool_errors", 1, ts, **tn, **base)
            if use_ts is not None and ts >= use_ts:
                add("claude_tx_tool_latency_seconds", (ts - use_ts) / 1e9, ts,
                    **tn, **base)
        # A human turn = a user message that isn't purely tool_result plumbing.
        if not (isinstance(content, list) and results and len(results) == len(content)):
            add("claude_tx_turns", 1, ts, **base)


def main() -> int:
    ap = argparse.ArgumentParser(description="Ship Claude Code transcripts to Loki.")
    ap.add_argument("--projects", default="*",
                    help="glob over project dir names under ~/.claude/projects (default: all)")
    ap.add_argument("--limit", type=int, default=0,
                    help="cap records shipped this run (0 = no cap; for testing)")
    ap.add_argument("--dry-run", action="store_true",
                    help="parse + redact + count, but do not send or advance offsets")
    ap.add_argument("--reset", action="store_true",
                    help="ignore saved offsets (re-ship everything)")
    ap.add_argument("--insecure", action="store_true",
                    help="plaintext gRPC (no TLS) — for a local port-forward to the gateway")
    args = ap.parse_args()

    secrets = harvest_secrets(REPO_VALUES)
    print(f"redaction: harvested {len(secrets)} secret literals from {REPO_VALUES}")

    # Oldest file first so the synthetic ingestion timestamps (below) line up with
    # real chronology when scrolling the content panel.
    files = sorted(glob.glob(str(PROJECTS_DIR / args.projects / "*.jsonl")),
                   key=lambda f: os.path.getmtime(f))
    if not files:
        print("no transcripts matched")
        return 0

    # Loki rejects entries older than ~max_chunk_age behind a stream's head
    # ("entry too far behind"), so back-dated transcripts can't be backfilled once a
    # stream holds recent data. We therefore stamp each record with a monotonically
    # increasing INGESTION timestamp (always ahead of the head → always accepted) and
    # keep the real time as the `event_time` attribute. Loki time == ship order.
    ts_base = time.time_ns()
    ts_seq = 0

    state = {} if args.reset else load_state()
    host = socket.gethostname()

    exporter = batch = provider = None
    if not args.dry_run:
        from opentelemetry.sdk._logs import LoggerProvider
        from opentelemetry.sdk._logs.export import BatchLogRecordProcessor
        from opentelemetry.sdk.resources import Resource
        from opentelemetry.exporter.otlp.proto.grpc._log_exporter import OTLPLogExporter
        from opentelemetry._logs import SeverityNumber
        endpoint, headers = load_settings()
        endpoint = re.sub(r"^https?://", "", endpoint)
        resource = Resource.create({
            "service.name": "claude-code-transcripts",
            "service.namespace": "claude-code",
            "host.name": host,
        })
        provider = LoggerProvider(resource=resource)
        # The OTLP exporter already retries transient gRPC errors (UNAVAILABLE)
        # with internal exponential backoff up to `timeout`; on top of that we
        # flush per file and retry the flush, advancing a file's offset ONLY once
        # its records are confirmed flushed (see flush_with_retry / per-file save).
        exporter = OTLPLogExporter(endpoint=endpoint,
                                   headers=tuple(headers.items()), insecure=args.insecure,
                                   timeout=30)
        # Large backfills emit records faster than the exporter drains; the
        # default 2048-deep queue overflows ("Queue full, dropping Log"). Size it
        # for a full backfill.
        batch = BatchLogRecordProcessor(exporter, max_queue_size=65536,
                                        max_export_batch_size=512)
        provider.add_log_record_processor(batch)
        logger = provider.get_logger("platypod.transcript-shipper")

        # Metrics path: build OTLP gauge datapoints by hand (the metrics SDK won't
        # backdate), accumulate per metric name, export once at the end.
        from opentelemetry.sdk.metrics.export import (
            Gauge, Metric, MetricsData, NumberDataPoint, ResourceMetrics,
            ScopeMetrics)
        from opentelemetry.exporter.otlp.proto.grpc.metric_exporter import (
            OTLPMetricExporter)
        from opentelemetry.sdk.util.instrumentation import InstrumentationScope
        metric_exporter = OTLPMetricExporter(endpoint=endpoint,
                                             headers=tuple(headers.items()),
                                             insecure=args.insecure, timeout=30)
        metric_series: dict[str, list] = {}

        def add_metric(name: str, value: float, ts_ns: int, **attrs) -> None:
            attrs = {k: v for k, v in attrs.items() if v not in (None, "")}
            metric_series.setdefault(name, []).append(NumberDataPoint(
                attributes=attrs, start_time_unix_nano=int(ts_ns),
                time_unix_nano=int(ts_ns), value=value))

    def flush_with_retry(attempts: int = 4) -> bool:
        """Force-flush the batch, retrying with exponential backoff (2,4,8,…s)."""
        for i in range(attempts):
            if batch.force_flush(timeout_millis=30000):
                return True
            delay = 2 ** (i + 1)
            print(f"  flush failed; retry {i + 1}/{attempts} in {delay}s", flush=True)
            time.sleep(delay)
        return False

    shipped, failed_files = 0, []
    for fp in files:
        p = Path(fp)
        try:
            st = p.stat()
        except OSError:
            continue
        meta = state.get(fp, {})
        offset = meta.get("offset", 0)
        if meta.get("inode") != st.st_ino or st.st_size < offset:
            offset = 0  # rotated or truncated → re-read
        if offset >= st.st_size:
            continue

        project = p.parent.name
        titles = session_titles(p)
        with p.open("rb") as fh:
            fh.seek(offset)
            data = fh.read()
        # only consume up to the last complete line
        last_nl = data.rfind(b"\n")
        if last_nl == -1:
            continue
        consumed = last_nl + 1
        lines = data[:consumed].decode("utf-8", errors="replace").splitlines()

        # tool_use_id → (tool_name, use_epoch_ns), built as we walk the file in
        # chronological order so a tool_result can be matched to its tool_use for
        # latency/error metrics. (A use/result pair split across two shipper runs
        # won't be matched — its latency datapoint is simply skipped.)
        tool_use_map: dict[str, tuple[str, int]] = {}

        for line in lines:
            line = line.strip()
            if not line:
                continue
            try:
                o = json.loads(line)
            except ValueError:
                continue
            if o.get("type") not in CONTENT_TYPES:
                continue
            msg = o.get("message") if isinstance(o.get("message"), dict) else {}
            sid = o.get("sessionId", "")
            attrs = {
                "fmt": "text",  # body-format marker — dashboards filter on it so a
                                # format change never mixes old/new bodies (Loki keeps
                                # both when the body changes; this hides the stale ones)
                "session_id": sid,
                "session_title": titles.get(sid, ""),
                "project": project,
                "type": str(o.get("type", "")),
                "role": str(msg.get("role", "")),
                "uuid": str(o.get("uuid", "")),
                "parent_uuid": str(o.get("parentUuid", "")),
                "git_branch": str(o.get("gitBranch", "")),
                "cc_version": str(o.get("version", "")),
            }
            attrs.update(tool_fields(msg))
            attrs = {k: v for k, v in attrs.items() if v}
            body = redact(render_body(o), secrets)
            if o.get("timestamp"):
                attrs["event_time"] = str(o["timestamp"])  # real time, kept as metadata
            ts_seq += 1
            if not args.dry_run:
                logger.emit(
                    timestamp=ts_base + ts_seq,        # monotonic ingestion time
                    observed_timestamp=time.time_ns(),
                    severity_number=SeverityNumber.INFO,
                    body=body, attributes=attrs,
                )
                emit_metrics(o, msg, sid, project, titles.get(sid, ""),
                             tool_use_map, add_metric)
            shipped += 1
            limit_hit = bool(args.limit and shipped >= args.limit)
            if limit_hit:
                break
        else:
            limit_hit = False

        # Confirm this file's records are flushed before advancing its offset, so
        # a transient push failure is re-shipped next run instead of being lost.
        if args.dry_run:
            pass
        elif flush_with_retry():
            state[fp] = {"inode": st.st_ino, "offset": offset + consumed}
            save_state(state)
        else:
            failed_files.append(p.name)  # offset NOT advanced → retried next run
        if limit_hit:
            break

    if not args.dry_run:
        if metric_series:
            # One MetricsData with every datapoint blows past gRPC's 4MB message
            # limit on a full backfill (RESOURCE_EXHAUSTED). Export in datapoint-
            # bounded chunks, preserving metric-name grouping within each chunk.
            CHUNK = 5000
            flat = [(n, dp) for n, dps in metric_series.items() for dp in dps]
            n_pts, failed = len(flat), 0
            for i in range(0, n_pts, CHUNK):
                grouped: dict[str, list] = {}
                for name, dp in flat[i:i + CHUNK]:
                    grouped.setdefault(name, []).append(dp)
                md = MetricsData(resource_metrics=[ResourceMetrics(
                    resource=resource,
                    scope_metrics=[ScopeMetrics(
                        scope=InstrumentationScope("platypod.transcript-shipper"),
                        metrics=[Metric(name=n, description="", unit="",
                                        data=Gauge(data_points=dps))
                                 for n, dps in grouped.items()],
                        schema_url="")],
                    schema_url="")])
                try:
                    metric_exporter.export(md)
                except Exception as e:  # best-effort; never fail the run on metrics
                    failed += 1
                    print(f"WARNING: metric chunk export failed: {e}")
            metric_exporter.force_flush(10000)
            print(f"metrics: exported {n_pts} datapoints across "
                  f"{len(metric_series)} series"
                  + (f" ({failed} chunk(s) failed)" if failed else ""))
            metric_exporter.shutdown()
        provider.shutdown()
    verb = "(dry-run) would ship" if args.dry_run else "shipped"
    print(f"{verb} {shipped} records{f' (limit {args.limit})' if args.limit else ''}")
    if failed_files:
        print(f"WARNING: push failed for {len(failed_files)} file(s) after retries "
              f"(offsets not advanced — re-run to retry): {', '.join(failed_files[:5])}"
              f"{'…' if len(failed_files) > 5 else ''}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
