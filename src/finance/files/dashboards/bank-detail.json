          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT label, count(*) AS operations, sum(amount) AS amount FROM gold.bank_transaction_detail WHERE needs_review AND amount < 0 GROUP BY label ORDER BY sum(amount) LIMIT 30",
