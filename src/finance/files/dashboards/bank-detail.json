          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT spend_date AS date, account, person, amount, label, family, category, subcategory, txn_id FROM gold.bank_transaction_detail WHERE needs_review ORDER BY abs(amount) DESC",
