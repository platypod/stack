          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT year AS \"Year\", sum(gross_amount) AS \"Gross\", sum(employee_contributions) AS \"Employee contrib.\", sum(pas_amount) AS \"Tax withheld\", sum(net_paid) AS \"Net paid\", round(100 * sum(net_paid) / sum(gross_amount), 1) AS \"Net/gross %\" FROM gold.income_monthly GROUP BY year ORDER BY year",
